{
  "name": "zotero-zettelkasten",
  "type": "module",
  "version": "0.2.3",
  "description": "Export Zotero bibliography entries with annotations as Obsidian/Zettelkasten notes",
  "config": {
    "addonName": "Zotero Zettelkasten",
    "addonID": "zettelkasten@dannyzimm",
    "addonRef": "zettelkasten",
    "addonInstance": "Zettelkasten",
    "prefsPrefix": "extensions.zotero.zettelkasten"
  },
  "author": "dannyzimm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dannyzimmer/zottelkasten.git"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "release": "zotero-plugin release"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
